[Unit]
Description=Cache Suspense Case episodes
After=network-online.target iptv-cache-http.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=IPTV_CACHE_DATA_DIR=/vol2/iptv-cache
Environment=IPTV_CACHE_PUBLIC_BASE=http://192.168.1.5:8788
ExecStart=/home/onehao/iptv-cache-service/bin/cache-xuanan all
ExecStartPost=/home/onehao/iptv-cache-service/bin/write-xuanan-playlist
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
